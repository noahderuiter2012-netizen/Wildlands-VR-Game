});

// Basic collision avoidance around major solid structures.
// This prototype does not yet include full terrain collision.
const solidAreas = [
  { x: -43, z: -33, radius: 7.5 }
];

function isNearSolid(x, z) {
  for (const area of solidAreas) {
    if (Math.hypot(x - area.x, z - area.z) < area.radius) {
      return true;
    }
  }
  return false;
}

// Find the region name from the player's approximate location.
function getRegionName(x, z) {
  if (x < -75 && z > 20) return 'Ancient Forest';
  if (x < -60 && z < -35) return 'Mountain Foothills';
  if (x > 65 && z > 45) return 'Riverlands';
  if (x > 60 && z < -50) return 'Highland Wilds';
  if (z < -95) return 'Northern Wilderness';
  if (z > 95) return 'Southern Wilds';
  return 'Ancient Forest';
}

let lastRegion = '';

function updateHud() {
  const x = camera.position.x;
  const z = camera.position.z;
  const region = getRegionName(x, z);

  if (region !== lastRegion) {
    lastRegion = region;
    $('location').textContent = region;
    $('objectiveText').textContent =
      region === 'Ancient Forest'
        ? 'Explore the forgotten wilds. Seek the ancient ruins.'
        : `Explore ${region}. Watch for ancient discoveries.`;
  }

  $('coordinates').textContent =
    `X ${x.toFixed(0)} · Z ${z.toFixed(0)}`;
}

// Keyboard and joystick movement.
// Movement is relative to the player's horizontal facing direction.
function updateMovement(delta) {
  if (renderer.xr.isPresenting) return;

  let forward = 0;
  let sideways = 0;

  if (keys['w'] || keys['arrowup']) forward += 1;
  if (keys['s'] || keys['arrowdown']) forward -= 1;
  if (keys['a'] || keys['arrowleft']) sideways -= 1;
  if (keys['d'] || keys['arrowright']) sideways += 1;

  forward += -moveInput.y;
  sideways += moveInput.x;

  const magnitude = Math.hypot(forward, sideways);
  if (magnitude > 1) {
    forward /= magnitude;
    sideways /= magnitude;
  }

  const sprinting = keys['shift'];
  const speed = player.speed *
    (sprinting ? player.sprintMultiplier : 1);

  cameraForward.set(
    -Math.sin(player.yaw), 0, -Math.cos(player.yaw)
  );
  cameraRight.set(
    Math.cos(player.yaw), 0, -Math.sin(player.yaw)
  );

  moveDirection.set(0, 0, 0);
  moveDirection.addScaledVector(cameraForward, forward);
  moveDirection.addScaledVector(cameraRight, sideways);

  const step = speed * delta;
  const nextX = camera.position.x + moveDirection.x * step;
  const nextZ = camera.position.z + moveDirection.z * step;

  // Do not walk through the main ruin foundation.
  if (!isNearSolid(nextX, nextZ)) {
    camera.position.x = nextX;
    camera.position.z = nextZ;
  }

  // Keep the player within the prototype's terrain bounds.
  camera.position.x = THREE.MathUtils.clamp(
    camera.position.x, -210, 210
  );
  camera.position.z = THREE.MathUtils.clamp(
    camera.position.z, -210, 210
  );
}

// Lightweight environmental animation.
function animateEnvironment(time) {
  const seconds = time * 0.001;

  for (let i = 0; i < animatedFire.length; i++) {
    const item = animatedFire[i];
    const flicker = Math.sin(seconds * 8 + item.phase) * 0.09 +
      Math.sin(seconds * 13 + item.phase) * 0.045;

    if (item.mesh) {
      item.mesh.scale.y = 1 + flicker;
      item.mesh.rotation.y += 0.006;
      item.mesh.position.y = item.baseY + flicker * 0.5;
    }

    if (item.light) {
      item.light.intensity =
        item.baseIntensity + Math.sin(seconds * 11) * 0.45;
    }
  }

  for (let i = 0; i < animatedCrystals.length; i++) {
    const crystal = animatedCrystals[i];
    crystal.rotation.y += 0.004;
    crystal.position.y +=
      Math.sin(seconds * 1.7 + i) * 0.0009;
  }

  // Subtle water-sheet shimmer. Geometry remains stationary.
  for (let i = 0; i < animatedWater.length; i++) {
    const water = animatedWater[i];
    if (water.material && water.material.transparent) {
      water.material.opacity =
        0.58 + Math.sin(seconds * 2 + i) * 0.04;
    }
  }
}

// WebXR support check.
async function setupVR() {
  if (!navigator.xr) {
    $('vrButton').textContent = 'VR unavailable';
    showNotice(
      'WebXR is unavailable in this browser. Explore in desktop or mobile mode.',
      5000
    );
    return;
  }

  try {
    vrSupported = await navigator.xr.isSessionSupported('immersive-vr');

    if (vrSupported) {
      $('vrButton').textContent = 'Enter VR';
      showNotice('VR is supported. Put on your compatible headset.');
    } else {
      $('vrButton').textContent = 'VR unavailable';
      showNotice(
        'This browser or device does not currently support immersive VR.',
        4500
      );
    }
  } catch (error) {
    $('vrButton').textContent = 'VR unavailable';
  }
}

$('vrButton').addEventListener('click', async () => {
  if (renderer.xr.isPresenting) {
    const session = renderer.xr.getSession();
    if (session) await session.end();
    return;
  }

  if (!navigator.xr) {
    showNotice('WebXR is not available here. Try a compatible VR browser over HTTPS.');
    return;
  }

  try {
    const supported = await navigator.xr.isSessionSupported('immersive-vr');

    if (!supported) {
      showNotice('Immersive VR is not supported by this browser/device.');
      return;
    }

    const session = await navigator.xr.requestSession('immersive-vr', {
      optionalFeatures: ['local-floor', 'bounded-floor']
    });

    await renderer.xr.setSession(session);
    $('vrButton').textContent = 'Exit VR';

    session.addEventListener('end', () => {
      $('vrButton').textContent = 'Enter VR';
      showNotice('VR session ended.');
    });
  } catch (error) {
    console.error('Could not start VR:', error);
    showNotice(
      'Could not start VR. Check HTTPS, headset browser compatibility and permissions.',
      5000
    );
  }
});

// VR controller locomotion.
// Left controller thumbstick moves relative to the headset's facing direction.
function updateVRMovement(delta) {
  if (!renderer.xr.isPresenting) return;

  const session = renderer.xr.getSession();
  if (!session) return;

  const sources = session.inputSources;
  let stickX = 0;
  let stickY = 0;

  for (const source of sources) {
    if (!source.gamepad) continue;

    const axes = source.gamepad.axes;
    if (!axes || axes.length < 2) continue;

    // Most controllers expose thumbstick axes here.
    if (source.handedness === 'left') {
      stickX = Math.abs(axes[2] || 0) > 0.01
        ? axes[2] : axes[0];
      stickY = Math.abs(axes[3] || 0) > 0.01
        ? axes[3] : axes[1];
      break;
    }
  }

  if (Math.abs(stickX) < 0.12) stickX = 0;
  if (Math.abs(stickY) < 0.12) stickY = 0;

  const xrCamera = renderer.xr.getCamera(camera);
  const direction = new THREE.Vector3();
  xrCamera.getWorldDirection(direction);
  direction.y = 0;
  direction.normalize();

  const right = new THREE.Vector3()
    .crossVectors(direction, worldUp)
    .normalize();

  const movement = new THREE.Vector3()
    .addScaledVector(direction, -stickY)
    .addScaledVector(right, stickX);

  if (movement.lengthSq() > 1) movement.normalize();

  // Move the XR reference space's parent camera rig.
  // For this simple prototype, locomotion is applied to the camera.
  camera.position.addScaledVector(
    movement, player.speed * delta
  );

  camera.position.x = THREE.MathUtils.clamp(
    camera.position.x, -210, 210
  );
  camera.position.z = THREE.MathUtils.clamp(
    camera.position.z, -210, 210
  );
}

// Performance-friendly frame loop.
function animate(time) {
  const delta = Math.min(clock.getDelta(), 0.05);

  if (!renderer.xr.isPresenting) {
    updateMovement(delta);
  } else {
    updateVRMovement(delta);
  }

  animateEnvironment(time);
  updateHud();

  renderer.render(scene, camera);
}

renderer.setAnimationLoop(animate);

