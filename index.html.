const clock = new THREE.Clock();

const player = {
  speed: 7.0,
  sprintMultiplier: 1.65,
  yaw: 0,
  pitch: 0,
  verticalVelocity: 0,
  grounded: true
};

const keys = Object.create(null);
const moveInput = { x: 0, y: 0 };
const cameraForward = new THREE.Vector3();
const cameraRight = new THREE.Vector3();
const moveDirection = new THREE.Vector3();
const worldUp = new THREE.Vector3(0, 1, 0);

let pointerLocked = false;
let joystickPointer = null;
let lookPointer = null;
let previousLookX = 0;
let previousLookY = 0;
let gameStarted = false;
let vrSupported = false;

const spawnPoint = new THREE.Vector3(0, 1.75, 12);

// Reusable temporary vectors avoid creating new objects every frame.
function updateCameraDirection() {
  camera.rotation.order = 'YXZ';
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;
}

function showNotice(message, duration = 2600) {
  notice.textContent = message;
  notice.style.display = 'block';

  if (showNotice.timer) clearTimeout(showNotice.timer);
  showNotice.timer = setTimeout(() => {
    notice.style.display = 'none';
  }, duration);
}

// Starting position and direction.
camera.position.copy(spawnPoint);
